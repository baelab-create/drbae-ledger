rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['baewongyu@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function ledgerOk(key) {
      return key.size() >= 20
        && exists(/databases/$(database)/documents/ledgers/$(key))
        && get(/databases/$(database)/documents/ledgers/$(key)).data.active == true;
    }

    // 본사: 전체 읽기·쓰기 (컬렉션 그룹 조회 포함)
    match /{document=**} {
      allow read, write: if isOwner();
    }

    // 파트너: 자기 링크 키 아래만
    match /ledgers/{key} {
      allow get: if resource.data.active == true;
      allow list: if false;
      allow update: if ledgerOk(key)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']);

      match /shops/{id} {
        allow read: if ledgerOk(key);
        // 생성: 서버 시각(createdAtTs)을 반드시 포함 → 관리 시작일을 파트너가 조작할 수 없음.
        //       별칭·이관 승인·보류 같은 본사 전용 필드는 파트너가 넣을 수 없음.
        allow create: if ledgerOk(key)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 200
          && request.resource.data.createdAtTs == request.time
          && !request.resource.data.keys().hasAny(['aliases', 'transferOk', 'pendingTransfer', 'hold', 'movedFrom', 'cert']);
        // 수정: 본사 전용 필드와 시작일 관련 필드는 바꿀 수 없음.
        allow update: if ledgerOk(key)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 200
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['aliases', 'transferOk', 'pendingTransfer', 'hold', 'movedFrom', 'createdAtTs', 'createdAt', 'regDate', 'cert']);
        allow delete: if false;
      }
      match /acts/{id} {
        allow read: if ledgerOk(key);
        allow create, update: if ledgerOk(key)
          && request.resource.data.shopId is string
          && request.resource.data.date is string
          && request.resource.data.method in ['전화', '카톡', '문자', '대면'];
        allow delete: if ledgerOk(key);
      }
      match /orders/{id} {
        allow read: if ledgerOk(key);
        allow write: if false;
      }
      // 신규 발굴 대상(본사가 넣음). 파트너는 읽고, 등록 상태·메모만 바꿀 수 있음
      match /leads/{id} {
        allow read: if ledgerOk(key);
        allow update: if ledgerOk(key)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'shopId', 'memo', 'updatedAt']);
        allow create, delete: if false;
      }
    }

    // 동기화 시각: 파트너 화면 상단 표시용 (at·by만 저장, 상세는 private/sync에만 두고 본사만 읽음)
    match /meta/sync {
      allow get: if true;
    }

    // 마이크로젝션 입점 가능 확인 — 격자 답안(숫자만)은 칸 단위로만 읽을 수 있고 목록 조회는 불가
    match /mjgrid/{cell} {
      allow get: if true;
      allow list: if false;
    }
    match /meta/mjgrid {
      allow get: if true;
    }
    // 파트너 조회 기록: 자기 링크 키로만 추가, 읽기는 본사만
    match /mj_checks/{id} {
      allow create: if ledgerOk(request.resource.data.key)
        && request.resource.data.addr is string
        && request.resource.data.addr.size() <= 200;
      allow read, update, delete: if false;
    }
  }
}
